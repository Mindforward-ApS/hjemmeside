# The platform (sign-in, sign-up, checkout). Defaults to https://app.mindforward.dk.
NEXT_PUBLIC_APP_URL=

# Blog (Strapi, see cms/README.md). Without these the blog is empty and stays out of the sitemap.
STRAPI_API_URL=
STRAPI_API_TOKEN=

# Secret for the Strapi webhook that refreshes the blog: POST /api/revalidate?secret=...
REVALIDATE_SECRET=

# Show placeholder proof in production (never on mindforward.dk).
NEXT_PUBLIC_VIS_PLADSHOLDERE=
